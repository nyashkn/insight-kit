{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["bun", "node"]
	},
	"include": ["./**/*.ts"],
	"exclude": ["node_modules", "dist", "**/node_modules"]
}
