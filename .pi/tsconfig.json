{
  "//": "T18 — typecheck scope for the L3 pi extension. pi + typebox resolve from the repo devDependencies (pinned to the installed pi version).",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "bun"]
  },
  "include": ["extensions/**/*.ts", "lib/**/*.ts", "test/**/*.ts"]
}
